# Modelo ilustrativo para desenvolvimento local; não é uma configuração pronta.
# A stack e as variáveis definitivas dependem da decisão arquitetural da equipe.
# Nunca coloque credenciais reais neste arquivo; mantenha valores locais em .env.

# Exemplo de URL relacional (PostgreSQL é apenas exemplo, não SGBD aprovado)
URL_DO_BANCO=postgresql://eventfy:SUBSTITUA_LOCALMENTE@localhost:5432/eventfy_db

# Exemplo somente se a solução de autenticação usar JWT; gere um segredo localmente
CHAVE_SECRETA_JWT=GERAR_SEGREDO_LOCALMENTE

# Armazenamento local para desenvolvimento; produção depende da arquitetura aprovada
LOCAL_DOS_ARQUIVOS=./uploads
NIVEL_DO_REGISTRO=INFO

# Exemplo de configuração do servidor; nomes e valores finais dependem da stack
PORTA=3000
