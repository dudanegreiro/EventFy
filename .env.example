# Copie para .env e substitua a senha pela definida para o usuário local.
# Nunca coloque credenciais reais neste arquivo; mantenha valores locais em .env.
URL_DO_BANCO=postgresql://eventfy_dev:SUBSTITUA_LOCALMENTE@127.0.0.1:5432/eventfy

# Configuração das entregas de autenticação e anexos (EVT-04 e RF19).
# Gere um segredo aleatório local quando habilitar a autenticação.
CHAVE_SECRETA_JWT=
LOCAL_DOS_ARQUIVOS=./uploads

# Observabilidade e identificação do ambiente (EVT-33 e EVT-37).
AMBIENTE=desenvolvimento
VERSAO_APP=0.2.0
NIVEL_LOG=INFO
