# Exemplo para desenvolvimento local com PostgreSQL 17 e FastAPI.
# Nunca coloque credenciais reais neste arquivo; mantenha valores locais em .env.

# URL local para uso futuro pela aplicacao; ajuste usuario e senha da instalacao.
URL_DO_BANCO=postgresql://postgres:ALTERE_LOCALMENTE@localhost:5432/eventfy

# Gere localmente um segredo aleatorio com pelo menos 32 caracteres.
CHAVE_SECRETA_JWT=GERAR_SEGREDO_LOCAL_DE_PELO_MENOS_32_CARACTERES

# Armazenamento local para desenvolvimento; produção depende da arquitetura aprovada
LOCAL_DOS_ARQUIVOS=./uploads
NIVEL_DO_REGISTRO=INFO

PORTA=8000
