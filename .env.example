# Exemplo de configuração de ambiente para o EventFy (sem segredos reais)
# Copie este arquivo para .env em desenvolvimento local

# Banco de Dados
URL_DO_BANCO=postgresql://eventfy:troque-esta-senha@localhost:5432/eventfy_db

# Segurança e Autenticação
CHAVE_SECRETA_JWT=chave-secreta-de-desenvolvimento-local-troque-em-producao

# Serviços Externos
CHAVE_DO_EMAIL=chave-de-teste-sem-valor

# Armazenamento e Logs
LOCAL_DOS_ARQUIVOS=/tmp/eventfy-uploads
NIVEL_DO_REGISTRO=INFO

# Servidor
PORTA=3000
VERSAO=v0.1.0
